<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Omitted because Vinu's provisioning profile does not grant Communication Notifications. Restore only after Apple enables the capability for this App ID and profile. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:go.rocket.chat</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.vinu.rocketchat</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.vinu.rocketchat</string>
	</array>
</dict>
</plist>
